{
  "title": "Пример формы",
  "titleKey": "form_title",
  "elements": [
    { "name": "username", "label": "Имя пользователя", "labelKey": "username_label", "type": "text", "required": true },
    { "name": "hasComment", "label": "Добавить комментарий?", "labelKey": "has_comment_label", "type": "checkbox", "default": false },
    { "name": "comment", "label": "Комментарий", "labelKey": "comment_label", "type": "textarea", "default": "Комментарий по умолчанию", "bind": { "visibleWhen": "hasComment == true" } },
    { "name": "width", "label": "Ширина", "labelKey": "width_label", "type": "number", "min": 0, "default": 5 },
    { "name": "height", "label": "Высота", "labelKey": "height_label", "type": "number", "min": 0, "default": 3 },
    { "name": "area", "label": "Площадь (вычисляется)", "labelKey": "area_label", "type": "number", "disabled": true, "bind": { "computed": "width * height" } },
    { "name": "tags", "label": "Теги", "labelKey": "tags_label", "type": "array", "itemType": "text", "maxItems": 5 },
    {
      "name": "servers", "label": "Серверы", "labelKey": "servers_label", "type": "matrix",
      "columns": [
        { "name": "ip", "label": "IP-адрес", "labelKey": "col_ip", "type": "text" },
        { "name": "cores", "label": "Ядра", "labelKey": "col_cores", "type": "number", "min": 1 }
      ]
    },
    {
      "name": "contacts", "label": "Контакты", "labelKey": "contacts_label", "type": "list",
      "rowLabel": "Контакт {index}", "rowLabelKey": "contact_row",
      "template": [
        { "name": "fullName", "label": "ФИО", "labelKey": "contact_fullname", "type": "text", "required": true },
        { "name": "email", "label": "E-mail", "labelKey": "contact_email", "type": "email" }
      ]
    }
  ],
  "translations": {
    "en": {
      "form_title": "Example Form",
      "username_label": "Username",
      "has_comment_label": "Add a comment?",
      "comment_label": "Comment",
      "width_label": "Width",
      "height_label": "Height",
      "area_label": "Area (computed)",
      "tags_label": "Tags",
      "servers_label": "Servers",
      "col_ip": "IP address",
      "col_cores": "Cores",
      "contacts_label": "Contacts",
      "contact_row": "Contact {index}",
      "contact_fullname": "Full name",
      "contact_email": "E-mail"
    }
  }
}
